# Application
APP_ENV=production
APP_PORT=3000
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DB_PASSWORD=change_this_to_a_long_random_password
DATABASE_URL=postgresql://cms_user:changeme@db:5432/cms_db?schema=public

# Session (generate with: openssl rand -base64 32)
SESSION_SECRET=changeme_generate_secure_random_string_32_chars_min

# Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif,image/svg+xml

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Site defaults (overridable in admin settings)
SITE_NAME=Mijn Website
SITE_DESCRIPTION=Een professionele website gebouwd met CMS
DEFAULT_LANGUAGE=nl
